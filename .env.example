# Get your API key at: https://vast.ai/console/cli/
VAST_API_KEY=your_api_key_here

# HuggingFace token — needed for gated models (e.g. Gemma) and fast downloads.
# Get yours at: https://huggingface.co/settings/tokens
# Make sure the token account has accepted the terms of any gated models used.
HF_TOKEN=

# URL of the infracloud repo to clone on remote instances (required for uv stacks
# and for stacks that provision from the repo, like comfyui-ltx23-10eros)
INFRACLOUD_REPO_URL=https://github.com/your-user/infracloud.git

# CivitAI API token — only needed if downloading models from CivitAI
CIVITAI_TOKEN=
